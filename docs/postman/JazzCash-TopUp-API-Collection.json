        },
        "url": {
          "raw": "{{base_url}}/payments/jazzcash/inquiry/",
          "protocol": "http",
          "host": ["{{base_url}}"],
          "path": ["payments", "jazzcash", "inquiry", ""]
        },
        "description": "Look up a tag by chip TID and return the consumer's details. Read-only."
      },
