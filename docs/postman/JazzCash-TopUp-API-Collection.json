{
  "info": {
    "name": "QTag JazzCash TopUp API v1",
    "description": "JazzCash integration for QTag topup system. Tag inquiry and payment notification endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1️⃣ TAG INQUIRY",
      "item": [
        {
          "name": "Kashif Mughal (1500 PKR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000704A8F9F0AE3\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/inquiry/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "inquiry", ""]
            },
            "description": "Look up Kashif's tag"
          }
        },
        {
          "name": "Ahmed Khan (3000 PKR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E2801105200070D4FB330A36\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/inquiry/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "inquiry", ""]
            },
            "description": "Look up Ahmed's tag"
          }
        },
        {
          "name": "Fatima Ali (500 PKR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000708A1B2C3D4E\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/inquiry/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "inquiry", ""]
            },
            "description": "Look up Fatima's tag"
          }
        },
        {
          "name": "Invalid Tag (Error Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"INVALID_TID_XXXXXXXX\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/inquiry/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "inquiry", ""]
            },
            "description": "Test error handling - should return 404"
          }
        }
      ]
    },
    {
      "name": "2️⃣ PAYMENT NOTIFICATION",
      "item": [
        {
          "name": "Kashif - Add 1000 PKR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000704A8F9F0AE3\",\n  \"amount\": \"1000.00\",\n  \"jazzcash_txn_id\": \"JC_KASHIF_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/payment/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "payment", ""]
            },
            "description": "Process topup for Kashif (1500 + 1000 = 2500)"
          }
        },
        {
          "name": "Ahmed - Add 500 PKR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
