            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E2801105200070D4FB330A36\",\n  \"amount\": \"500.00\",\n  \"jazzcash_txn_id\": \"JC_AHMED_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/payment/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "payment", ""]
            },
            "description": "Process topup for Ahmed (3000 + 500 = 3500)"
          }
        },
        {
          "name": "Fatima - Add 250 PKR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000708A1B2C3D4E\",\n  \"amount\": \"250.00\",\n  \"jazzcash_txn_id\": \"JC_FATIMA_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/payment/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "payment", ""]
            },
            "description": "Process topup for Fatima (500 + 250 = 750)"
          }
        },
        {
          "name": "Idempotency Test - Duplicate Kashif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000704A8F9F0AE3\",\n  \"amount\": \"1000.00\",\n  \"jazzcash_txn_id\": \"JC_KASHIF_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/payment/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "payment", ""]
            },
            "description": "Retry same txn_id - should return already_processed=true, balance unchanged"
          }
        },
        {
          "name": "Error - Invalid Amount (Zero)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000704A8F9F0AE3\",\n  \"amount\": \"0.00\",\n  \"jazzcash_txn_id\": \"JC_ERROR_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/payment/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "payment", ""]
            },
            "description": "Test validation - should return 400"
          }
        },
        {
          "name": "Error - Invalid Amount (Negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tid\": \"E28011052000704A8F9F0AE3\",\n  \"amount\": \"-500.00\",\n  \"jazzcash_txn_id\": \"JC_ERROR_002\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/jazzcash/payment/",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["payments", "jazzcash", "payment", ""]
            },
            "description": "Test validation - should return 400"
          }
        }
