# ── Django ──────────────────────────────────────────────────────────────────
# Use config.settings.production for production deployments
DJANGO_SETTINGS_MODULE=config.settings.local

# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=master_tag_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Primary DB host (main server)
DB_HOST=192.168.78.200

# Optional: local fallback — if DB_HOST is unreachable, connects here automatically
# psycopg2 tries DB_HOST first; waits 3s, then falls back to DB_FALLBACK_HOST
# Leave empty to disable fallback (single-host mode)
DB_FALLBACK_HOST=localhost

# ── CORS (production only — list your frontend origin) ───────────────────────
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# ── JazzCash payment gateway ─────────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:8000/api/v1/payments/jazzcash/callback/

# ── Push notifications (FCM HTTP v1) ──────────────────────────────────────────
# Both must be set for push to be attempted. Leave BLANK on the LAN deployment, which has
# no internet — every send is then skipped and /api/v1/notifications/status/ reports
# push_available=false, so the app does not claim notifications are on.
#
# FCM_CREDENTIALS_FILE is a PATH to the service-account JSON downloaded from
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Never commit that file.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# ── OTP delivery ─────────────────────────────────────────────────────────────
# 'console' (the default) logs the code instead of sending it, which is what makes
# the flow testable before an SMS gateway exists. 'twilio' needs TWILIO_* set.
SMS_BACKEND=console

# TESTING ONLY, and the two below are a PAIR — set both or neither.
#
# The first delivers the code to whichever device ASKED for it, so the app can be
# exercised on a real handset with no gateway. On its own that is a one-step account
# takeover: knowing a number would be enough to receive its code and set a new
# password. The second is the fence — only these numbers can reach that path, and
# every other account falls back to SMS as if the mode were off.
#
# config.settings.lan refuses to boot with the first set and the second empty.
# config.settings.production refuses the mode outright. Write each number exactly as
# the account stores it (03001234567, not +923001234567 — only spaces and dashes are
# normalised away), and empty the list when testing ends.
OTP_PUSH_TO_REQUESTING_DEVICE=False
OTP_DEV_PUSH_PHONES=

# Skip the SMS when a push demonstrably reached a device already bound to the account.
# Off by default: that device may be one the holder no longer carries.
OTP_PUSH_SUPPRESSES_SMS=False

# ── Tag issuance (booth registration) ────────────────────────────────────────
# How long a newly issued tag is valid for, in whole calendar months.
TAG_VALIDITY_MONTHS=24
# One-off issuance fee taken out of the cash collected at registration (the
# wallet is opened with amount - charge). The operator can override it per
# registration in the topup app; this is the prefilled default.
TOPUP_SERVICE_CHARGE=350.00
