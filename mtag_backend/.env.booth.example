# Per-booth .env template. Copy to .env on THIS booth's machine (gitignored —
# never commit the real one) and fill in the values below.
#
# This is deliberately different from the root .env.example, which is
# written for a single-server/dev setup. A booth has its OWN local Postgres
# and must know how to reach the separate master server.

# ── Django ─────────────────────────────────────────────────────────────────
# NOTE: ecosystem.config.js already sets this to config.settings.lan when
# run via PM2 — this line matters only if you run manage.py directly by hand
# (migrations, shell, etc.) outside PM2.
DJANGO_SETTINGS_MODULE=config.settings.lan

# Generate one per booth: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# This booth's own LAN IP/hostname (whatever the local operator UI is reached at)
ALLOWED_HOSTS=localhost,127.0.0.1,<this-booth-lan-ip>

# Booth mode — 'entry' or 'exit'. Drives which sync passes mtag-sync runs:
#   entry  push + pull(reference data, closed trips)
#   exit   push + pull(reference data, closed trips, OPEN trips)
# Must match this booth's actual lane. Written by booth_bootstrap.sh from
# $GATE_MODE; if unset the sync service defaults to 'exit' (the superset).
GATE_MODE=entry

# ── Database — THIS BOOTH'S OWN LOCAL POSTGRES ───────────────────────────────
DB_NAME=mtag_db
DB_USER=mtag_booth
DB_PASSWORD=change-me
DB_PORT=5432

# Always localhost — this booth's Django process talks to its own local
# Postgres, not the network. Do NOT put the master's IP here.
DB_HOST=localhost

# Leave empty — the multi-host failover feature (DB_HOST + DB_FALLBACK_HOST)
# is for switching between two *remote* hosts. Since DB_HOST is already
# localhost, there's nothing to fall back to on this same machine.
DB_FALLBACK_HOST=

# ── The settings that actually matter for cross-booth consistency ───────────
# The central server's LAN IP. This is what the sync agent (pull fare/
# inventory every 30s, push registrations) and the online-only dual-write in
# EntryService/ExitService both connect to.
MASTER_DB_HOST=<master-server-lan-ip>

# Master is a SEPARATE Postgres instance and very likely has a different
# database name than this booth's own local DB_NAME above — set these
# explicitly rather than relying on the (confusing) default of reusing
# DB_NAME/DB_USER. Only MASTER_DB_PASSWORD has a fallback (the historical
# hardcoded value) — always set it explicitly here too, don't rely on that.
MASTER_DB_NAME=<master's actual database name>
MASTER_DB_USER=<master's actual postgres user — likely the same as DB_USER>
MASTER_DB_PASSWORD=<master's actual postgres password>

# ── Online-only mode ─────────────────────────────────────────────────────────
# Leave commented out — defaults to True outside `manage.py test`, which is
# what you want on a real booth. Only set this if you deliberately need to
# fall back to local-write-only behavior (see docs/ONLINE-ONLY-ROLLOUT-PLAN.md
# §6 Rollback plan).
# ONLINE_ONLY_MODE=False

# ── JazzCash (leave blank unless this booth accepts JazzCash top-ups) ───────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
