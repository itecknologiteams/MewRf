# Per-booth .env template. Copy to .env on THIS booth's machine (gitignored —
# never commit the real one) and fill in the values below.
#
# This is deliberately different from the root .env.example, which is
# written for a single-server/dev setup. A booth has its OWN local Postgres
# and must know how to reach the separate master server.

# ── Django ─────────────────────────────────────────────────────────────────
# NOTE: ecosystem.config.js already sets this to config.settings.lan when
# run via PM2 — this line matters only if you run manage.py directly by hand
# (migrations, shell, etc.) outside PM2.
DJANGO_SETTINGS_MODULE=config.settings.lan

# Generate one per booth: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# This booth's own LAN IP/hostname (whatever the local operator UI is reached at)
ALLOWED_HOSTS=localhost,127.0.0.1,<this-booth-lan-ip>

# Booth mode — 'entry' or 'exit'. Drives which sync passes mtag-sync runs:
#   entry  push + pull(reference data, closed trips)
#   exit   push + pull(reference data, closed trips, OPEN trips)
# Must match this booth's actual lane. Written by booth_bootstrap.sh from
# $GATE_MODE; if unset the sync service defaults to 'exit' (the superset).
GATE_MODE=entry

# ── Database — MASTER'S POSTGRES. THIS BOOTH HAS NO LOCAL DATABASE ───────────
# Strict online-only: the booth's Django process talks straight to master. There
# is no local Postgres to install, migrate or seed, and booth_update.sh refuses
# to start a booth whose DB_HOST is still localhost.
#
# Consequence worth being explicit about: if the link to master drops, this booth
# stops working entirely — the barrier will not open. That is the accepted
# trade-off for having exactly one copy of the data and no sync to reconcile.
#
# All four of these are MASTER's values. Use the same ones you gave
# deploy_master.sh (DB_NAME/DB_USER/DB_PASSWORD there).
DB_NAME=master_tag_db
DB_USER=rfid
DB_PASSWORD=<the rfid role's password>
DB_PORT=5432

# Master's address as reachable FROM THIS BOOTH — the LAN IP, not the public one.
DB_HOST=192.168.78.200

# Optional second address for the same database, tried when DB_HOST does not
# answer. Only useful if master is reachable two ways (e.g. a public IP as a
# backup path); leave empty otherwise.
DB_FALLBACK_HOST=

# ── MASTER_DB_* — keep identical to the DB_* block above ─────────────────────
# Some code paths open an explicit 'master_pg' connection (services.py reads an
# entry recorded at another plaza). With no local database that is the same
# server as `default`, so these must match DB_* exactly. Leaving them unset
# would fall back to DB_* anyway, but being explicit keeps the intent readable.
MASTER_DB_HOST=192.168.78.200
MASTER_DB_NAME=master_tag_db
MASTER_DB_USER=rfid
MASTER_DB_PASSWORD=<the rfid role's password>

# ── Online-only mode ─────────────────────────────────────────────────────────
# Leave commented out — defaults to True outside `manage.py test`, which is
# what you want on a real booth. Only set this if you deliberately need to
# fall back to local-write-only behavior (see docs/ONLINE-ONLY-ROLLOUT-PLAN.md
# §6 Rollback plan).
# ONLINE_ONLY_MODE=False

# ── JazzCash (leave blank unless this booth accepts JazzCash top-ups) ───────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
