# ============================================================================
# MewRf monorepo .gitignore
#   mtag_backend (Django) · rfid-frontend / bulk-tags (Vite/React) ·
#   scanner_app / topup_app (Flutter) · HopeLand_SDK (vendor SDK)
# ============================================================================

# ── Secrets / local env ─────────────────────────────────────────────────────
.env
*.env
!*.env.example
!.env.example
*.local

# ── Python / Django ─────────────────────────────────────────────────────────
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
*$py.class
**/staticfiles/
*.sqlite3
db.sqlite3
*.log

# ── Node / Vite / React (rfid-frontend, bulk-tags) ──────────────────────────
**/node_modules/
**/dist/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Flutter / Dart (scanner_app, topup_app) ─────────────────────────────────
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/*.iml
# Android build / local
**/android/.gradle/
**/android/.kotlin/
**/android/local.properties
**/android/captures/
**/android/app/release/
**/*.keystore
**/*.jks
# iOS / build outputs
**/ios/Flutter/.last_build_id
# NOTE: Hopeland SDK libs ARE committed (needed to build the apps):
#   scanner_app/android/app/libs/*.aar|*.jar, .../src/main/jniLibs/**

# ── IDE / editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ────────────────────────────────────────────────────────────────────
*.tar.gz
*.zip

# Deploy scripts — these hold the master DB/SSH credentials in plain text and
# this repo is public. Kept on disk, out of git.
deploy_booths.sh
deploy_booth.sh
deploy_master.sh

# Per-booth camera URLs for set_camera.sh — one line per lane, and every
# line carries a camera password.
cameras.txt
*.cameras

# Bundled Python wheels for offline booth installs (rebuilt by deploy_booths.sh)
mtag_backend/wheelhouse/

# curl session jar — holds a live JWT refresh token
cookies.txt
