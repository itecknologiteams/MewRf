<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher masks these layers to the device's shape and parallaxes
     them. The foreground is the M-E wordmark, drawn at 58% of the canvas so no mask can
     clip it.

     No <monochrome> layer: Android 13 themed icons tint a SINGLE-COLOUR glyph, and this
     mark is a two-colour wordmark whose orange road is half its identity. Flattening it to
     one colour would ship a worse logo than simply opting out. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
